<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.OptiFinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OptiFinePage_Loaded">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                <!-- 页面标题随模式切换：OptiFine / LiteLoader -->
                <TextBlock
                    x:Name="TitleText"
                    Margin="0,0,0,8"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="OptiFine" />

                <ComboBox
                    x:Name="BaseCombo"
                    Width="320"
                    Header="基础版本（需为原版且已下载完整）"
                    HorizontalAlignment="Left"
                    SelectionChanged="BaseCombo_SelectionChanged" />

                <!-- OptiFine 区块 -->
                <StackPanel x:Name="OfSection" Spacing="12">
                    <ComboBox
                        x:Name="OfCombo"
                        Width="320"
                        Header="OptiFine 版本"
                        HorizontalAlignment="Left"
                        PlaceholderText="正在获取版本列表…" />
                    <Button
                        x:Name="QueueOfButton"
                        Click="QueueOf_Click"
                        Content="加入下载列表"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <!-- LiteLoader 区块 -->
                <StackPanel x:Name="LlSection" Spacing="12">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="仅支持 Minecraft 1.12.2 及更早版本。"
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="LlCombo"
                        Width="320"
                        Header="LiteLoader 版本"
                        HorizontalAlignment="Left"
                        PlaceholderText="正在获取版本列表…" />
                    <Button
                        x:Name="QueueLlButton"
                        Click="QueueLl_Click"
                        Content="加入下载列表"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <TextBlock
                    x:Name="StatusText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 首次加载：列表拉取中 -->
        <ProgressRing
            x:Name="PageRing"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True" />
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUI3Shell.Pages.QuiltPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Quilt 安装器" />

        <!-- 缓存/刷新状态单独一行，避免和按钮挤在一起被截断 -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="1"
            Margin="0,8,0,8"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="2">
            <ListView
                x:Name="BuildList"
                SelectionChanged="BuildList_SelectionChanged" />
            <ProgressRing
                x:Name="LoadingRing"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="QueueSelectedButton"
                Content="加入下载列表"
                IsEnabled="False"
                Style="{StaticResource AccentButtonStyle}"
                Click="QueueSelected_Click" />
        </StackPanel>
    </Grid>
</Page>
